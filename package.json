{
  "name": "taktak",
  "version": "0.1.0",
  "private": true,
  "description": "TakTak settings and tray UI (Svelte 5 + TypeScript), rendered by the Tauri app in src-tauri.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run && npm run test:scripts",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "tauri": "tauri",
    "release": "node scripts/release.mjs",
    "app": "node scripts/app.mjs",
    "notices": "node scripts/notices.mjs",
    "no-network": "node scripts/no-network.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^24.0.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  }
}
